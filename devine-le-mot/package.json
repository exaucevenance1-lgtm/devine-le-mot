{
  "name": "devine-le-mot",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "windows": "react-native run-windows",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm test",
    "doctor": "node scripts/check-env.js",
    "setup:android": "node scripts/setup-native.js android",
    "setup:windows": "node scripts/setup-native.js windows",
    "build:android": "node scripts/build.js android",
    "build:android:debug": "node scripts/build.js android debug",
    "build:windows": "node scripts/build.js windows"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.24.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-windows": "^0.76.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.6",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "typescript": "5.0.4"
  }
}
